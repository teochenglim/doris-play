# ── LLM provider ────────────────────────────────────────────────────────────
# Pick ONE block, leave the rest commented.

# Note: Doris 4.1 ai.endpoint must be the FULL URL (incl. /chat/completions)

# Option A · OpenAI
# LLM_PROVIDER=openai
# LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-YOUR-KEY-HERE

# Option B · DeepSeek  (OpenAI-compatible, cheap)
# LLM_PROVIDER=openai
# LLM_ENDPOINT=https://api.deepseek.com/v1/chat/completions
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=sk-YOUR-DEEPSEEK-KEY

# Option C · Anthropic
# LLM_PROVIDER=anthropic
# LLM_ENDPOINT=https://api.anthropic.com
# LLM_MODEL=claude-3-5-haiku-20241022
# LLM_API_KEY=sk-ant-YOUR-KEY

# Option D · Ollama (local)
# host.docker.internal lets Doris (in Docker) reach Ollama on the host
LLM_PROVIDER=openai
LLM_ENDPOINT=http://host.docker.internal:11434/v1/chat/completions
LLM_MODEL=llama3.1:8b
LLM_API_KEY=ollama

# ── Embedding (vector demo) ──────────────────────────────────────────────────
# EMBED_ENDPOINT is used by the Python script (runs on host, so localhost works)
EMBED_ENDPOINT=http://localhost:11434/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024
